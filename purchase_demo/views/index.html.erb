<!doctype html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= purchase_text("ui.page_title") %></title>
  <style>
    :root{color-scheme:light;--ink:#193b31;--muted:#607169;--line:#d6e0d7;--paper:#fffef9;--green:#205b43;--wash:#f0f4ec}*{box-sizing:border-box}body{margin:0;background:var(--wash);color:var(--ink);font-family:system-ui,-apple-system,"Noto Sans JP",sans-serif;font-size:15px;line-height:1.7}a{color:var(--green);text-underline-offset:3px}header,main,footer{max-width:1160px;margin:auto;padding:24px 32px}header{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:15px;border-bottom:1px solid var(--line)}.brand{font-weight:800;letter-spacing:.06em}.brand span{font-weight:400;color:var(--muted);font-size:12px;margin-left:12px}.test{border:1px solid #cfb370;background:#fff5d8;color:#6f5316;border-radius:30px;padding:5px 13px;font-size:12px;font-weight:700}.eyebrow{font-size:12px;letter-spacing:.12em;font-weight:800;color:var(--green);margin:12px 0}h1{font-size:clamp(26px,4vw,40px);line-height:1.35;letter-spacing:-.03em;margin:10px 0 16px}h2{font-size:20px;margin:0 0 14px}h3{font-size:15px;margin:0 0 8px}p{margin:8px 0 16px}.intro{max-width:780px;color:var(--muted)}.grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:22px;margin:28px 0}.card{min-width:0;overflow-wrap:anywhere;background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:25px;box-shadow:0 5px 16px #193b3105}.section-label{font-size:11px;font-weight:800;color:var(--muted);letter-spacing:.12em;margin-bottom:12px}.tea{width:52px;height:52px;border-radius:50%;background:#e5eed9;display:flex;align-items:center;justify-content:center;color:#406637;font-size:24px;font-weight:700}.product{display:flex;align-items:center;gap:14px;margin:18px 0}.product strong{font-size:20px}.subtle{color:var(--muted);font-size:13px}.terms{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:20px 0}.term{background:#f1f5ed;padding:13px;border-radius:10px}.term small{display:block;color:var(--muted)}.term strong{font-size:24px}label.field{display:block;font-weight:650;font-size:13px;margin:20px 0 7px}select{width:100%;padding:11px;border:1px solid #9baea0;border-radius:8px;background:white;color:var(--ink);font:inherit;font-size:13px}.consent{display:flex;gap:10px;align-items:flex-start;margin:18px 0;font-size:13px}.consent input{width:18px;height:18px;flex:none;margin-top:3px;accent-color:var(--green)}button,.button{display:inline-block;background:var(--green);color:white;border:1px solid var(--green);border-radius:9px;padding:11px 17px;font:inherit;font-size:13px;font-weight:700;text-decoration:none;cursor:pointer}button:hover,.button:hover{background:#143e2c}button:focus-visible,a:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid #b77c1f;outline-offset:3px}.wide{width:100%}.secondary{color:var(--green);background:transparent}.secondary:hover{background:#e5eedf}.notice{padding:12px 16px;border-radius:10px;background:#e0efdf;border:1px solid #a8c1a4;margin:12px 0}.alert{background:#fff0dc;border-color:#d6b37a;color:#6a4b1d}.stage{display:grid;grid-template-columns:30px 1fr;gap:12px;padding:16px 0;border-top:1px solid var(--line)}.number{width:26px;height:26px;display:flex;justify-content:center;align-items:center;background:#eaf0e5;border-radius:50%;font-size:12px;font-weight:800}.stage p{margin:2px 0;font-size:12px;color:var(--muted)}.status{display:inline-block;margin-top:5px;padding:3px 9px;border-radius:5px;background:#edf1e9;font-size:12px;font-weight:700;overflow-wrap:anywhere}.identifier{font-family:ui-monospace,monospace;font-size:12px;overflow-wrap:anywhere;padding:11px;background:#f0f3ed;border-radius:8px}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}.actions form{margin:0}.execution{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);padding-top:15px;margin-top:10px;font-size:13px}.execution strong{font-size:24px}.roles{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.role{border-top:3px solid #7f9c71;padding:17px;background:#f8faf4;border-radius:4px}.role p{font-size:13px;color:var(--muted);margin:0}.role small{font-size:11px;font-weight:750;color:var(--green)}details{margin-top:22px}summary{cursor:pointer;font-weight:650;font-size:13px}details p,details li{font-size:13px;color:var(--muted)}.history{list-style:none;padding:0;margin:0}.history li{display:flex;gap:12px;justify-content:space-between;border-top:1px solid var(--line);padding:12px 0;font-size:12px;overflow-wrap:anywhere}footer{color:var(--muted);font-size:12px;padding-top:0}.empty{padding:40px 8px;text-align:center;color:var(--muted)}.empty strong{display:block;color:var(--ink);font-size:18px;margin-bottom:8px}@media(max-width:800px){.grid,.roles{grid-template-columns:1fr}header,main,footer{padding:20px}.brand span{display:none}.card{padding:20px}h1 br{display:none}.history li{display:block}}
.languages{display:flex;align-items:center;gap:9px;flex-wrap:wrap;font-size:13px}.languages a[aria-current="true"]{font-weight:800;text-decoration-thickness:3px}.execution{gap:12px}.execution strong{flex-shrink:0}.stage>div{min-width:0}select{min-width:0}button{white-space:normal} .history a{min-width:0}@media(max-width:420px){.terms{grid-template-columns:1fr}.execution{align-items:flex-start}.actions,.actions form,.actions button,.actions a{width:100%}}
  </style>
</head>
<body>
<header>
  <a class="brand" href="<%= purchase_path('/') %>">TEA PURCHASE LAB<span><%= purchase_text("ui.brand_description") %></span></a>
  <nav class="languages" aria-label="<%= purchase_text('ui.language') %>">
    <% {"en" => "English", "ja" => "日本語"}.each do |locale, label| %>
      <a href="<%= language_path(locale) %>" lang="<%= locale %>" hreflang="<%= locale %>" aria-current="<%= I18n.locale.to_s == locale %>"><%= label %></a>
    <% end %>
  </nav>
  <span class="test"><%= purchase_text("ui.test_only") %></span>
</header>
<main>
  <p class="eyebrow"><%= purchase_text("ui.eyebrow") %></p>
  <h1><%= purchase_text("ui.headline_first") %><br><%= purchase_text("ui.headline_second") %></h1>
  <p class="intro"><%= purchase_text("ui.intro") %></p>
  <% if flash[:notice] %><div class="notice" role="status"><%= purchase_text("flash.#{flash[:notice]}") %></div><% end %>
  <% if flash[:alert] %><div class="notice alert" role="alert"><%= purchase_text("flash.#{flash[:alert]}") %></div><% end %>
  <div class="grid">
    <section class="card" aria-labelledby="approval-title">
      <div class="section-label"><%= purchase_text("ui.approval_section") %></div><h2 id="approval-title"><%= purchase_text("ui.approval_title") %></h2>
      <div class="product"><div class="tea" aria-hidden="true"><%= purchase_text("ui.product_symbol") %></div><div><strong><%= purchase_text("ui.product") %></strong><div class="subtle"><%= purchase_text("ui.merchant_currency") %></div></div></div>
      <div class="terms"><div class="term"><small><%= purchase_text("ui.quantity") %></small><strong>3</strong> <%= purchase_text("ui.bags") %></div><div class="term"><small><%= purchase_text("ui.budget") %></small><strong>3,000</strong> JPY</div></div>
      <p class="subtle"><%= purchase_text("ui.approval_explainer") %></p>
      <form action="/approve" method="post">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="hidden" name="locale" value="<%= I18n.locale %>">
        <input type="hidden" name="draft_id" value="<%= @draft_id %>">
        <label class="field" for="scenario"><%= purchase_text("ui.scenario") %></label>
        <select name="scenario" id="scenario"><% @scenarios.each do |value, label| %><option value="<%= value %>"><%= label %></option><% end %></select>
        <label class="consent"><input type="checkbox" name="approved" value="1" required><span><%= purchase_text("ui.consent") %></span></label>
        <button class="wide" type="submit"><%= purchase_text("ui.approve") %></button>
      </form>
      <p class="subtle"><%= purchase_text("ui.approval_only") %></p>
    </section>
    <section class="card" aria-labelledby="result-title">
      <div class="section-label"><%= purchase_text("ui.result_section") %></div><h2 id="result-title"><%= purchase_text("ui.result_title") %></h2>
      <% if @purchase %>
        <% offer = @purchase.fetch("offer", {}) %>
        <div class="subtle"><%= purchase_text("ui.purchase_id") %></div><div class="identifier"><%= @purchase["purchase_id"] %></div>
        <p class="subtle"><%= purchase_text("ui.current_approval") %><br><%= purchase_text("ui.current_scenario", scenario: @scenarios.fetch(@purchase["scenario"], purchase_text("ui.unknown_scenario"))) %><br><%= purchase_text("ui.offer", quantity: offer["quantity"] || purchase_text("ui.pending"), amount: offer["amount"] || purchase_text("ui.pending"), currency: offer["currency"] || "JPY") %></p>
        <% %w[ap2 app payment receipt].each_with_index do |stage, i| %>
          <div class="stage"><span class="number"><%= i + 1 %></span><div><h3><%= purchase_text("stages.#{stage}.title") %></h3><p><%= purchase_text("stages.#{stage}.description") %></p><span class="status" data-stage="<%= stage %>"><%= status_text(@purchase["#{stage}_status"]) %></span></div></div>
        <% end %>
        <% if @purchase["reason"].present? %><p class="notice" data-purchase-reason><%= reason_text(@purchase["reason"]) %></p><% end %>
        <div class="execution"><span><%= purchase_text("ui.execution_count") %></span><strong><%= @purchase["execution_count"] || 0 %></strong></div>
        <div class="actions">
          <form action="/purchases/<%= @purchase["purchase_id"] %>/run" method="post"><input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>"><input type="hidden" name="locale" value="<%= I18n.locale %>"><button type="submit"><%= purchase_text("ui.run") %></button></form>
          <form action="/purchases/<%= @purchase["purchase_id"] %>/recover" method="post"><input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>"><input type="hidden" name="locale" value="<%= I18n.locale %>"><button class="secondary" type="submit"><%= purchase_text("ui.recover") %></button></form>
          <a class="button secondary" href="<%= purchase_path("/purchases/#{@purchase['purchase_id']}") %>&amp;refresh=1"><%= purchase_text("ui.refresh") %></a>
        </div>
        <p class="subtle"><%= purchase_text("ui.recovery_warning") %></p>
      <% else %>
        <div class="empty"><strong><%= purchase_text("ui.empty_title") %></strong><%= purchase_text("ui.empty_description") %></div>
        <% %w[ap2 app payment receipt].each_with_index do |stage, i| %><div class="stage"><span class="number"><%= i + 1 %></span><div><h3><%= purchase_text("stages.#{stage}.title") %></h3><span class="status"><%= purchase_text("ui.not_performed") %></span></div></div><% end %>
      <% end %>
    </section>
  </div>
  <section class="card"><div class="section-label"><%= purchase_text("ui.roles_section") %></div><h2><%= purchase_text("ui.roles_title") %></h2><div class="roles">
    <% %w[authority buyer merchant].each do |role| %>
      <div class="role"><small><%= purchase_text("ui.#{role}_label") %></small><h3><%= purchase_text("ui.#{role}_title") %></h3><p><%= purchase_text("ui.#{role}_description") %></p></div>
    <% end %>
  </div><details><summary><%= purchase_text("ui.limitations_title") %></summary><p><%= purchase_text("ui.limitations") %></p><p><%= purchase_text("ui.privacy") %></p></details></section>
  <% if @purchases.any? %><section class="card" style="margin-top:22px"><h2><%= purchase_text("ui.history") %></h2><ul class="history"><% @purchases.each do |purchase| %><li><a href="<%= purchase_path("/purchases/#{purchase['purchase_id']}") %>"><%= purchase["purchase_id"] %></a><span><%= @scenarios.fetch(purchase["scenario"], purchase_text("ui.unknown_scenario")) %> · <%= purchase_text("ui.executions", count: purchase["execution_count"] || 0) %></span></li><% end %></ul></section><% end %>
</main><footer><%= purchase_text("ui.footer") %></footer>
</body></html>
