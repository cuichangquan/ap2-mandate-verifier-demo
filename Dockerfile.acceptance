# Optional published-example image; normal Rails dependencies stay unchanged.
ARG DEMO_BASE=ap2-mandate-verifier-demo:local
FROM ${DEMO_BASE}
RUN bundle exec ruby test/installed_gem_check.rb && \
    gem fetch sqlite3 --version 2.10.2 --platform aarch64-linux-gnu && \
    echo 'e9aea2c2b3476fc875dd8a89313a9a2862818519c0186bfb5b56d6f57bb08d98  sqlite3-2.10.2-aarch64-linux-gnu.gem' | sha256sum -c - && \
    gem install --local --no-document sqlite3-2.10.2-aarch64-linux-gnu.gem && \
    ruby -e 'gem "sqlite3", "= 2.10.2"; require "sqlite3"; abort unless SQLite3::VERSION == "2.10.2"' && \
    rm sqlite3-2.10.2-aarch64-linux-gnu.gem
COPY examples/payment_acceptance.rb examples/long_payment.rb /demo/examples/
CMD ["ruby", "examples/payment_acceptance.rb"]
