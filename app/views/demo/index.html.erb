<!doctype html>
<html lang="<%= I18n.locale %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= t("demo.page_title") %></title>
<style>
*{box-sizing:border-box}body{font-family:system-ui,sans-serif;background:#f5f4ef;color:#18332e;margin:0;padding:40px 20px;line-height:1.6}main{max-width:760px;margin:auto;min-width:0}h1{font-size:2rem;line-height:1.25}h1,h2,h3,p,dd,a,button,label{overflow-wrap:anywhere}section{background:white;border:1px solid #d6ddd6;border-radius:18px;padding:24px;margin:24px 0}.warning{background:#fff1c7;border-left:6px solid #9b6200;padding:18px}button{background:#175d50;color:white;border:0;border-radius:8px;padding:13px 22px;font-size:1rem;cursor:pointer;max-width:100%;white-space:normal}label{display:block;margin:18px 0}small{color:#465b55}code{overflow-wrap:anywhere;word-break:break-word}h2{margin-top:0}a{color:#175d50}a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid #9b6200;outline-offset:3px}.languages{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:12px;margin-bottom:16px}.languages a{padding:6px 10px;border:1px solid #175d50;border-radius:6px}.languages [aria-current=page]{background:#175d50;color:white}.demo-nav ul{padding-left:24px}.receipt-details{padding-left:24px}dt{font-weight:600}dd{margin:0 0 12px}fieldset{padding:0;border:0;min-width:0}legend{font-size:1.5rem;font-weight:700}input[type=radio]{accent-color:#175d50}@media(max-width:480px){body{padding:20px 12px}section{padding:18px 16px}h1{font-size:1.7rem}.languages{justify-content:flex-start}}
</style></head>
<body><main>
<nav class="languages" aria-label="<%= t("demo.language_label") %>">
  <% { "en" => "English", "ja" => "日本語" }.each do |locale, label| %>
    <%= link_to label, locale_url(locale), lang: locale, hreflang: locale, aria: { current: I18n.locale.to_s == locale ? "page" : nil } %>
  <% end %>
</nav>
<small>AP2 MANDATE VERIFIER · <%= Gem.loaded_specs.fetch("ap2_mandate_verifier").version %> · <%= t("demo.local_demo") %></small>
<h1><%= t("demo.heading") %></h1>
<section aria-label="<%= t("demo.introduction.label") %>"><h2><%= t("demo.introduction.title") %></h2>
<p><%= t("demo.introduction.concepts") %></p>
<p><%= t("demo.introduction.next") %></p>
<p><%= t("demo.introduction.examples_before") %> <%= link_to t("demo.introduction.examples_link"), I18n.locale == :ja ? "https://github.com/cuichangquan/ap2-mandate-verifier-demo/blob/main/README.ja.md" : "https://github.com/cuichangquan/ap2-mandate-verifier-demo#readme" %><%= t("demo.introduction.examples_after") %></p>
<p><%= t("demo.introduction.boundary") %></p>
</section>
<nav class="demo-nav" aria-label="<%= t("demo.navigation_label") %>"><ul>
<li><%= link_to t("demo.home_link"), demo_url(:index) %></li>
<li><%= link_to t("demo.merchant_link"), demo_url(:merchant) %></li>
<% if MultiItemScenario.available? %><li><%= link_to t("demo.multi_item_link"), demo_url(:multi_item) %></li><% end %>
</ul></nav>
<% if @input_error %><p class="warning" role="alert"><%= t("demo.errors.#{@input_error}") %></p><% end %>
<% if @outcome || @merchant_scenario || @multi_item_scenarios %><p class="snapshot-notice"><%= t("demo.snapshot_notice") %></p><% end %>
<% if @snapshot_expired %><p class="warning" role="status"><%= t("demo.snapshot_expired") %></p><% end %>
<% if %w[merchant multi_item].include?(action_name) %><p><%= link_to t("demo.rerun"), demo_url(action_name, run: "1") %></p><% end %>
<% if @multi_item_scenarios %><section id="multi-item-scenario"><h2><%= t("demo.multi_item.title") %></h2>
<p><%= t("demo.multi_item.profile") %> <code><%= MultiItemScenario::PROFILE %> v1</code>. <%= t("demo.multi_item.explanation") %></p>
<% @multi_item_scenarios.each_with_index do |scenario, index| %>
<h3><%= t(index.zero? ? "demo.multi_item.valid" : "demo.multi_item.short") %></h3>
<ul><% scenario[:lines].each do |line| %><li><%= t("demo.multi_item.line", product: t("demo.multi_item.products.#{line["item"]["id"]}"), quantity: line["quantity"], price: line["item"]["price"]) %></li><% end %></ul>
<p><%= t("demo.multi_item.total", amount: scenario[:amount]) %> / <code><%= scenario[:status] %> / <%= scenario[:code] %></code><br><%= t("demo.result.evidence") %>: <%= t(scenario[:evidence_present] ? "demo.result.evidence_present" : "demo.result.evidence_absent") %></p>
<%= render "diagnostic", diagnostic: diagnostic_for(scenario[:diagnostics]) if scenario[:diagnostics] %>
<% scenario[:rows].each do |row| %><%= render "receipt", row: row %><% end %>
<% end %><p><%= t("demo.multi_item.boundary") %></p></section><% end %>
<% if @merchant_scenario %><section id="merchant-scenario"><h2><%= t("demo.merchant.title") %></h2>
<p><%= t("demo.merchant.checkout_hash") %>: <code data-value="checkout-hash"><%= @merchant_scenario[:checkout_hash] %></code><br>
<%= t("demo.merchant.reference") %>: <code data-value="mandate-reference"><%= @merchant_scenario[:reference] %></code></p>
<% @merchant_scenario[:rows].each do |row| %><%= render "receipt", row: row %><% end %>
<p><%= t("demo.merchant.boundary") %></p></section><% end %>
<p><%= t("demo.workflow") %></p>
<p><%= t("demo.comparison") %></p>
<p class="warning"><strong><%= t("demo.warning_title") %></strong><br><%= t("demo.warning_body") %></p>
<section><%= form_with url: demo_url(:verify), local: true do %>
  <fieldset><legend><%= t("demo.choose_scenario") %></legend>
  <%= hidden_field_tag :locale, I18n.locale %>
  <% ScenarioVerifier::SCENARIOS.each do |key| %>
    <label><%= radio_button_tag :scenario, key, (@scenario || "valid") == key %> <%= t("demo.scenarios.#{key}") %></label>
  <% end %>
  <%= button_tag t("demo.verify_button") %></fieldset>
<% end %></section>
<% if @outcome %><section aria-live="polite" id="result"><h2><%= t("demo.result.titles.#{@outcome.title_key}") %></h2>
<p><%= t("demo.result.reasons.#{@outcome.reason_key}") %></p>
<%= render "diagnostic", diagnostic: diagnostic_for(@outcome.diagnostics) if @outcome.diagnostics %>
<p><%= t("demo.result.evidence") %>: <%= t(@outcome.evidence_present ? "demo.result.evidence_present" : "demo.result.evidence_absent") %></p>
<small><%= t("demo.result.gem_result") %>: <code><%= @outcome.status %> / <%= @outcome.code %></code><br><%= t("demo.result.time") %>: <%= @outcome.time || t("demo.result.unknown") %></small></section><% end %>
<small><%= t("demo.footer.profile") %> <code>ap2.checkout.single_merchant_sku v1</code><br><%= t("demo.footer.synthetic") %><br><%= t("demo.footer.time") %></small>
</main></body></html>
